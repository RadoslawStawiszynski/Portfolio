# ============================================================
# PortfolioHub — Local Development (Docker) Variables
# Use when running via docker-compose.dev.yml
# Copy to .env.local and fill in R2/Resend keys
# ============================================================

# Local PostgreSQL (Docker container)
DATABASE_URL=postgresql://portfoliohub:portfoliohub@localhost:5432/portfoliohub

# Redis — @upstash/redis uses HTTP REST, not TCP. Docker Redis (localhost:6379) is NOT compatible.
# Use your real Upstash credentials from https://console.upstash.com (free tier available).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Payload CMS
PAYLOAD_SECRET=local-dev-secret-change-in-production-must-be-32-chars-min

# R2 — use real keys even locally (R2 is external)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfoliohub-dev
R2_ENDPOINT=

# Resend — use real key (free tier) or leave empty for console fallback
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@korp-cbm.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NODE_ENV=development

# Logging — debug shows all messages in dev
LOG_LEVEL=debug

# Cloudflare DNS API (optional — for automated DNS management)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
