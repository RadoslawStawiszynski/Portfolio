# ============================================================
# PortfolioHub — Environment Variables Template (Production)
# Copy to .env.local and fill in real values
# NEVER commit .env.local
# ============================================================

# === DATABASE (Neon PostgreSQL) ===
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/portfoliohub?sslmode=require

# === REDIS (Upstash) ===
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# === PAYLOAD CMS ===
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-to-random-string-min-32-chars

# === CLOUDFLARE R2 (Storage) ===
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=portfoliohub
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# === RESEND (Email) ===
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@korp-cbm.com

# === APP CONFIG ===
NEXT_PUBLIC_APP_URL=https://korp-cbm.com
NEXT_PUBLIC_SERVER_URL=https://korp-cbm.com
NEXT_PUBLIC_PLATFORM_DOMAIN=korp-cbm.com
NODE_ENV=production

# === LOGGING ===
# Options: error, warn, info, debug
LOG_LEVEL=info

# === CLOUDFLARE DNS API (optional — for automated DNS management) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# === SEED SCRIPTS (jednorazowe, nigdy nie commituj wypełnionych wartości) ===
# Hasła startowe dla scripts/seed-users.ts — generuj: openssl rand -base64 18
# Wymagane tylko przy tworzeniu NOWEGO konta (rerun dla istniejących userów ich nie potrzebuje)
SEED_MILOSZ_PASSWORD=
SEED_MARTYNA_PASSWORD=

# === SYSTEM ZAPROSZENIOWY ===
# Email superadmina — docelowy adres notyfikacji o nowych zgłoszeniach waitlist
SUPERADMIN_EMAIL=biuro@korp-cbm.com
# Secret dla GitHub Actions cron (expire-tokens) — wygeneruj: openssl rand -hex 32
CRON_SECRET=change-to-random-hex-32-chars
